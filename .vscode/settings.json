{
  "terminal.integrated.profiles.windows": {
    "Radioconda (PowerShell)": {
      "source": "PowerShell",
      "args": [
        "-NoExit",
        "-Command",
        "& cmd.exe /c 'D:\\Programs\\radioconda\\Scripts\\activate.bat && set' | ForEach-Object { if ($_ -match '^(.*?)=(.*)$') { Set-Item -Path \"env:$($matches[1])\" -Value $matches[2] } }"
      ]
    }
  },
  "terminal.integrated.defaultProfile.windows": "Radioconda (PowerShell)"
}